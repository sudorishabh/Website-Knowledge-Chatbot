# --- Python -----------------------------------------------------------------
venv/
.venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.tox/
.nox/
.ipynb_checkpoints/
.coverage
.coverage.*
coverage.xml
htmlcov/

# --- Secrets ----------------------------------------------------------------
# Only the template is shared; every real environment file stays local.
.env
.env.*
!.env.example

# --- Editors and OS ---------------------------------------------------------
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini
# Office lock files
~$*

# --- Local tooling ----------------------------------------------------------
# Local-only agent settings (keep out of VCS even without global gitignore)
.claude/settings.local.json
# opencode MCP config: it pins this machine's absolute checkout path
.opencode.json
# Added by code-review-graph
.code-review-graph/
# AST/graph cache written by the code-review-graph tooling. Regenerable, and
# under app/ it also trips tests/test_architecture.py, which reads every
# directory there as a package.
graphify-out/
# VSCodeCounter extension output (generated line-count reports)
.VSCodeCounter/

# --- Local data and runtime output ------------------------------------------
# Local data stays out of git, except the priority page list: it is read at
# question time and is the authority for the theme hierarchy.
data/*
!data/priority_crawl_pages.json
qdrant_storage/
pdf_examples/
tools/local_tests/results/
# Per-query retrieval traces (is_retrieval_log=true). Local debugging output:
# they describe one machine's corpus and queries, and are regenerated by asking
# the questions again. See docs/retrieval-logging.md.
logs/
*.log
# Ad-hoc CSV exports (scripts.report_date_candidates --csv ...)
/moves.csv
# Scratch copy of the Drupal content-type -> date-field map; nothing reads it
/date_field_key_work.json

# --- Reports ----------------------------------------------------------------
# Bulk inputs and per-version snapshots of the shadow date analysis. The
# reports, the current decision set and the corpus metadata stay tracked; these
# are the parts that are large and rebuildable:
#   drupal_metadata*.json      -> scripts.shadow_corpus_report --refresh
#   prototype_decisions.v*.csv -> superseded snapshots, kept only for the
#                                 version comparison that has already been written
reports/phase0/drupal_metadata*.json
reports/phase0/prototype_decisions.v*.csv
# Date-audit snapshots (scripts.audit_dates --json). Each one measures the
# corpus of the machine that produced it, and `--compare` reads it as the
# "before" state — so a snapshot committed by one developer would silently
# become another's baseline and report their normal corpus as a regression.
# Regenerating takes seconds; sharing them does not survive a different corpus.
reports/dates/*.json
# Per-document dumps of an e2e ingest audit run (tools.e2e_ingest_audit): the
# downloaded source PDFs plus every stage's output, ~65 MB per run. Each run's
# REPORT.md and summary JSON stay tracked; the dumps are rebuilt by re-running.
reports/e2e_ingest_audit/*/documents/
# Before/after snapshots and rerun lists from canary ingest runs. Like the
# date-audit snapshots they measure one machine's corpus at one moment.
reports/canary/
redundant