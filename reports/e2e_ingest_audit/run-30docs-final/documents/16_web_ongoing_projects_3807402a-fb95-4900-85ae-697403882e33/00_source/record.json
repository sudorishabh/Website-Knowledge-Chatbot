  "parsed_drupal_record": {
    "uuid": "3807402a-fb95-4900-85ae-697403882e33",
    "bundle": "ongoing_projects",
    "nid": 13383,
    "title": "Peer Review of Carbon Credit Methodology for Jute-Based Net CO2 Emission Reduction",
    "url": "https://teriin.org/project/peer-review-carbon-credit-methodology-jute-based-net-co2-emission-reduction",
    "body": "TERI is undertaking an independent technical peer review of the “Methodology for Carbon Crediting in Jute Cultivation Systems” (MC-JCS: TJF0001, Version 1.1) developed for The Jute Foundation. The assignment assesses whether the proposed methodology provides a scientifically robust, transparent and practically applicable framework for quantifying greenhouse gas emission reductions and carbon removals associated with jute cultivation systems.\n\nThe review covers the methodology’s scope and applicability, project boundaries, baseline and additionality provisions, treatment of annual jute biomass and soil organic carbon, cultivation- and retting-related emissions, permanence, uncertainty, monitoring, digital traceability and safeguards against double counting. It also examines the supporting calculation coefficients, equations, emission factors and assumptions used to estimate net carbon benefits.\n\nThe project aims to identify technical and methodological gaps and provide recommendations for strengthening the methodology before pilot application or consideration under a carbon-crediting programme. The review will support the development of a more credible and verifiable framework for linking improved jute cultivation practices, sustainable agriculture and farmer livelihoods with carbon-finance opportunities.",
    "created": "2026-09-08T10:34:19+00:00",
    "changed": "2026-09-08T10:35:59+00:00",
