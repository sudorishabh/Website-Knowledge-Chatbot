        "status": true,
        "title": "Establishing Resource and Knowledge Centre (RKC) for the Distribution Sector under the All-India Discoms Association (AIDA)",
        "created": "2026-09-08T10:45:06+00:00",
        "changed": "2026-09-08T10:48:10+00:00",
        "promote": true,
        "sticky": false,
