# Standard chat model (e.g. gpt-5-mini)
AZURE_OPENAI_MODEL=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-06-01

# Temperature for structured/deterministic LLM calls (query understanding,
# routing, rerank, faithfulness). Leave unset for reasoning models (gpt-5 /
# o-series) — they reject any value but the default. Set 0 for classic chat models.
# LLM_STRUCTURED_TEMPERATURE=0

# Embeddings model (e.g. text-embedding-3-large)
AZURE_OPENAI_EMBEDDING_MODEL=
AZURE_OPENAI_EMBEDDING_KEY=
AZURE_OPENAI_EMBEDDING_ENDPOINT=
AZURE_OPENAI_EMBEDDING_API_VERSION=2024-06-01
# Output vector size. text-embedding-3-{small,large} support truncation; 1536
# halves storage/search cost vs 3-large's native 3072. Leave blank for ada-002.
AZURE_OPENAI_EMBEDDING_DIMENSIONS=1536

# PDF extraction. EXTRACTION_MODE: hybrid (per-page routing, default) |
# azure_only | local_only. Azure Document Intelligence OCRs scanned pages:
# "prebuilt-read" = OCR only (cheap); "prebuilt-layout" ~6x cost, also tables.
EXTRACTION_MODE=hybrid
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=
AZURE_DOCUMENT_INTELLIGENCE_MODEL=prebuilt-read
PDF_SCANNED_CHAR_THRESHOLD=100
CAMELOT_FLAVOR=lattice

QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=documents
RETRIEVAL_CANDIDATE_K=40
RETRIEVAL_TOP_K=6

# MySQL — ingest-state manifest / document catalog (structured-query path).
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=
MYSQL_POOL_SIZE=5

# Redis (optional) — response + embedding caches; empty disables them.
# The semantic cache lives in Qdrant (SEMANTIC_CACHE_COLLECTION=semantic_cache).
REDIS_URL=

# Background sweep on the ingestion server (seconds; 0 disables).
WORKER_SWEEP_INTERVAL_SECONDS=3600

# --- Public retrieval API -------------------------------------------------
# Bearer-JWT auth on /chat, /search, /source. Off = anonymous (default/public).
AUTH_ENABLED=false
JWT_SECRET=
JWT_ALGORITHMS=HS256
# JWT_AUDIENCE=
# JWT_ISSUER=
# JWT_GROUPS_CLAIM=groups

# --- Knowledge graph (Neo4j) ------------------------------------------------
# Backs canonical entities, aliases and claims. A rebuildable projection of
# MySQL + Qdrant, never a system of record: if it is down the knowledge layer
# degrades and nothing is lost. Community edition has no role-based access
# control, so retrieval's read-only boundary is enforced in application code.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
# Community supports exactly one user database, named "neo4j".
# NEO4J_DATABASE=neo4j
# NEO4J_CONNECTION_TIMEOUT=10

# Master switch for the knowledge layer. OFF: nothing opens a Neo4j connection
# and ingestion/retrieval behave exactly as they do today.
# KNOWLEDGE_ENABLED=false
# Graph-backed retrieval, separate so the graph can be built and verified long
# before any query is allowed to read it.
# GRAPH_RETRIEVAL_ENABLED=false

# --- Retrieval logging (debugging / evaluation / analysis) -------------------
# One switch for a per-query JSON trace of the whole retrieval pipeline: what
# Qdrant, the graph and MySQL were each asked, what they returned, how long each
# took, what failed, and the context that reached the LLM. Written under
# RETRIEVAL_LOG_DIR (empty = <repo>/logs) as one directory per query, named after
# the question and the local time it was asked:
#   logs/<date>/<question> - <YYYY-MM-DD HH-MM-SS IST>/{trace.json,report.md}
# — the record, and the same thing explained in prose — plus an errors/ copy of
# anything that failed and a summary/<date>.jsonl digest.
# Off = the instrumentation is a boolean read; nothing is serialized or written.
# See docs/retrieval-logging.md.
is_retrieval_log=false
# RETRIEVAL_LOG_DIR=
# How each retrieved item is written. "compact" (default) is one line per item
# and one line per filter — a query reads in ~350 lines. "full" is the
# structured object with every payload field: ~10,000 lines for the same query,
# for programmatic analysis that needs them.
# RETRIEVAL_LOG_DETAIL=compact
# Keep retrieved passage text in the trace (false keeps ids/scores/metadata only).
# RETRIEVAL_LOG_INCLUDE_TEXT=true
# Ceilings, so one query cannot write a megabyte: per-string characters, and
# results captured per event (the recorded counts stay the true totals).
# RETRIEVAL_LOG_MAX_TEXT_CHARS=1200
# RETRIEVAL_LOG_MAX_RESULTS=10
# The clock used for the date folder and each query folder's name (timestamps
# inside a trace stay UTC ISO-8601).
# RETRIEVAL_LOG_TIMEZONE=Asia/Kolkata
# Write report.md beside each trace.json: the same query explained in prose.
# RETRIEVAL_LOG_REPORT=true
# RETRIEVAL_LOG_SUMMARY=true

# Pin the embedding host site(s) in production (comma-separated; * warns at startup).
CORS_ALLOW_ORIGINS=*
# Expose infra detail on /ready and /metrics (keep off on the public server).
OPS_DETAIL_ENABLED=false
# JWT group allowed to read /metrics and /metrics/timings even when
# OPS_DETAIL_ENABLED is off (requires AUTH_ENABLED=true).
# OPS_ADMIN_GROUP=admin

# --- Drupal source ---------------------------------------------------------
# DRUPAL_JSONAPI_BASE=https://teriin.org/jsonapi
# DRUPAL_INGEST_EXTERNAL_PDFS=false

# --- Theme taxonomy ----------------------------------------------------------
# The theme hierarchy documents are classified against (main themes, sub-themes
# and any depth below them). Defaults to the file shipped beside the app package,
# `app/theme_structure.json`, which is the tracked source of truth; set this only
# to point somewhere else.
#
# It is a *reference*, not a whitelist: a theme the CMS has and this file does
# not is still stored and still countable, classified `unknown`. What the file
# decides is the hierarchy — a theme's parent, its Main/Other bucket and its
# ancestor path.
#
# It is also load-bearing. If it cannot be read, classification does not fail;
# it succeeds and reports every theme as unmapped, which on the next ingest
# would rewrite the stored hierarchy of the whole corpus. So ingestion, the
# facet backfill and the reclassify script all refuse to start when it is
# missing. If a run aborts with `TaxonomyUnavailable`, restore the file — do not
# work around it.
# THEME_TAXONOMY_PATH=/srv/config/theme_structure.json

# --- Ingestion batching ------------------------------------------------------
# Cap the documents actually processed (new/changed/deleted) per run; the run
# stops cleanly at the cap and the next run resumes where it left off (bundles
# are always crawled oldest-first, so the high-water mark is a resume cursor).
# 0 = unlimited (default).
# INGEST_MAX_DOCS_PER_RUN=500
# Throttle within a run: sleep INGEST_BATCH_PAUSE_SECONDS after every
# INGEST_BATCH_SIZE processed documents (both must be > 0 to take effect).
# INGEST_BATCH_SIZE=25
# INGEST_BATCH_PAUSE_SECONDS=5
# Documents processed concurrently within the single run (one crawler feeding
# a worker pool). Keep below MYSQL_POOL_SIZE (default 5). 1 = sequential.
# INGEST_WORKERS=4
